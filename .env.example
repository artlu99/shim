# shim compose env — copy to .env on the box. NEVER commit the real .env.
# Bun auto-loads .env; dotenv also loads it in-process. compose env_file
# injects these into the app container.
# install.sh copies this to /opt/shim/.env when that file is missing.

# --- database: SQLite (bun:sqlite) ---
# Compose sets SQLITE_PATH=/app/data/shim.sqlite on the shimdata volume.
# Do not set SQLITE_PATH here. Local `bun dev` uses data/shim.sqlite.

# --- app -> lmdis (compose-internal hostname)
UPSTASH_REDIS_REST_URL=http://lmdis:3000
UPSTASH_REDIS_REST_TOKEN=CHANGE_ME_TOKEN

# --- lmdis server (SAME value as UPSTASH_REDIS_REST_TOKEN)
LMDIS_REST_TOKEN=CHANGE_ME_TOKEN

# OPTIONAL: Base RPC override for the social-contract check
# (default https://mainnet.base.org). Must be a bare JSON-RPC root.
# BASE_RPC_URL=

# Ingress is the box's existing cloudflared, not a compose service.
# Public hostname -> http://localhost:7300. No TUNNEL_TOKEN.

# Farcaster hub gRPC for /refresh. Bare host:port, no scheme.
# Example as of 2026-10-25: 107.20.169.236:3383
HUB_GRPC_ENDPOINT=CHANGE_ME

# Do not set DEV. DEV=FALSE disables the gRPC client
# (the check is DEV === "FALSE"). Leave it unset.
