# shim-SH compose env — copy to .env on the VPS. NEVER commit the real .env.
# Bun auto-loads .env; dotenv also loads it in-process. compose `env_file: .env`
# injects these into the app container.

# --- database: SQLite (bun:sqlite), NOT postgres ---
# The store path is set by compose (SQLITE_PATH=/app/data/shim.sqlite on the
# shimdata volume) — do NOT set SQLITE_PATH here.
# OPTIONAL: Neon source for seeding the store (`bun run backfill:sqlite`).
# Run it on the laptop and scp the file into the volume, or one-off in the
# container: `docker compose run --rm app bun run backfill:sqlite`.
# The app itself NEVER reads DATABASE_URL — safe to omit once seeded; the
# refresh path fetches everything from the hub.
# DATABASE_URL=postgres://...@ep-xxx.neon.tech/neondb?sslmode=require

# --- app -> pro-nft ponder DB (deploy secret; route stays)
DATABASE_URL_PRO_NFT=postgres://.../CHANGE_ME

# --- app -> lmdis (compose-internal hostname)
UPSTASH_REDIS_REST_URL=http://lmdis:3000
UPSTASH_REDIS_REST_TOKEN=CHANGE_ME_TOKEN

# --- lmdis server (SAME value as UPSTASH_REDIS_REST_TOKEN)
LMDIS_REST_TOKEN=CHANGE_ME_TOKEN

# OPTIONAL: Base RPC override for /signed/:fid (default https://mainnet.base.org)
# BASE_RPC_URL=

# NO TUNNEL_TOKEN: shim rides the box's existing remotely-managed cloudflared.
# Add the public hostname in the Zero Trust dashboard -> service http://localhost:7300.

# --- farcaster hub gRPC for the bulk refresh path. Bare host:port (no scheme) —
# the endpoint rotates when nodes die; copy the current value from upstream
# .env.example at cutover (example as of 2026-10-25: 107.20.169.236:3383)
HUB_GRPC_ENDPOINT=CHANGE_ME

# DO NOT SET DEV. DEV=FALSE is the inverted flag that DISABLES the gRPC client
# (DEV === "FALSE" -> disabled). Unset/anything-else -> enabled.
